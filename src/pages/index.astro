---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import Default from '../layouts/Default.astro';
import Award from '../components/Award.astro';

// Sorted by `sort` descending; ties broken by id (filename) descending.
const load = async (name: 'publications' | 'workshops') =>
  (await getCollection(name))
    .sort((a, b) => b.data.sort - a.data.sort || (a.id < b.id ? 1 : -1))
    .map((entry) => entry.data);

const publications = await load('publications');
const workshops = await load('workshops');
const highlighted = publications.filter((p) => p.highlighted === true);

function stripYear(entry: { year: number; conference?: string }): string {
  const prefix = `${entry.year} `;
  const conference = entry.conference ?? '';
  return conference.startsWith(prefix) ? conference.slice(prefix.length) : conference;
}

const isMe = (a: { first: string; last: string }) => a.first === 'Sebastian' && a.last === 'Hubenschmid';

function readBibtex(id: string): string {
  return fs.readFileSync(path.join(process.cwd(), 'public', 'bib', `${id}.bib`), 'utf-8').trim();
}
---
<Default title="Sebastian Hubenschmid" jsonLd>
<h1>About me</h1>
<section class="mono">
    <ul class="bullet-list">
        <li>Postdoctoral Research Fellow at Aarhus University, Denmark</li>
        <li>Ph.D. (Dr. rer. nat.) in Computer Science, University of Konstanz, Germany</li>
        <li>Former Research Assistant at the Human-Computer Interaction Group, University of Konstanz, Germany</li>
        <li>Former Senior Software Developer at ionCube Ltd., Canterbury, UK </li>
    </ul>
</section>


<h1>Highlighted Research</h1>
<section class="publications highlighted">

    <section class="about">
        My research combines <b>human-computer interaction</b>, <b>mixed reality</b>, and <b>visual analytics</b>.
        My work focuses on the field of <b>hybrid user interfaces</b>, which use cross-device interaction with complementary device technologies.
        In addition, my work on <b>ambient analytics</b> aims to bring calm computing to mixed reality by integrating immersive data visualizations harmoniously into the physical environment.
    </section>

    {highlighted.map((publication) => (
    <section class="publication highlighted">
        <div class="info">
            <div class="title small">
                {publication.doi
                    ? <a href={`https://doi.org/${publication.doi}`} target="_blank"><Fragment set:html={publication.title} /></a>
                    : <Fragment set:html={publication.title} />}
                <Award publication={publication} compact />
            </div>
        </div>

    </section>
    ))}
</section>


<h1> Publications </h1>
<section class="publications">

    {publications.map((publication) => (
    <section class="publication">
        <Award publication={publication} marker />
        <div class="info">
            <div class="title" set:html={publication.title} />

            <span class="authors">
                {publication.authors.map((author, i) => (
                <span class={isMe(author) ? 'me' : undefined}>
                    {author.equal ? <abbr title="Contributed equally">{author.first} {author.last}<sup>*</sup></abbr> : <>{author.first} {author.last}</>}{i < publication.authors.length - 1 ? ',' : '.'}
                </span>
                ))}
            </span>

            <br/>

            <span>{publication.year}</span>
            <span class="separator">/</span>
            <span class="conference">{stripYear(publication)}.</span>

        </div>

        {(publication.doi || publication.bibtex) && (
        <div class="citation">
            {publication.bibtex && (<>
            <input type="checkbox" id={publication.bibtex} class="bibtex-checkbox">
            <label for={publication.bibtex} class="bibtex-label">BibTeX</label>
            </>)}

            {publication.doi && publication.bibtex && (
            <span class="separator">/</span>
            )}

            {publication.doi && (
            <span class="doi">
                DOI:
                <a href={`https://doi.org/${publication.doi}`} target="_blank" rel="noopener">{publication.doi}</a>
            </span>
            )}

            {publication.bibtex && (
            <div class="bibtex-content">
                <pre><code>{readBibtex(publication.bibtex)}</code></pre>

                <a href={`/bib/${publication.bibtex}.bib`} class="download-button" aria-label="Download BibTeX" title="Download BibTeX" download>
                    <span class="icon"></span>
                </a>
            </div>
            )}

        </div>
        )}

        <div class="links">
            {(publication.links ?? []).map((link) => (
            <a class="link" href={link.url} target="_blank" rel="noopener">
                <span class="text">{link.name}</span>
            </a>
            ))}
        </div>

    </section>
    ))}
</section>


<h1> Workshops </h1>

<section class="publications">

    {workshops.map((workshop) => (
    <section class="publication">
        <div class="title" set:html={workshop.title} />

        <div class="info">
            <span class="authors">
                {workshop.authors.map((author, i) => (
                <span class={isMe(author) ? 'me' : undefined}>
                    {author.first} {author.last}{author.equal && <abbr title="Contributed equally"><sup>*</sup></abbr>}{i < workshop.authors.length - 1 ? ',' : '.'}
                </span>
                ))}
            </span>

            {workshop.conference && (<>
            <span>In:</span>
            <span class="conference">{stripYear(workshop)},</span>
            </>)}
            <span>{workshop.location}.</span>
            <span>{workshop.year}.</span>
        </div>

        {workshop.doi && (
        <div class="doi">DOI: <a href={`https://doi.org/${workshop.doi}`} target="_blank" rel="noopener">{workshop.doi}</a></div>
        )}

        <div class="links">
            {(workshop.links ?? []).map((link) => (
            <a class="link" href={link.url} target="_blank" rel="noopener">
                <span class="text">{link.name}</span>
            </a>
            ))}
        </div>

    </section>
    ))}

</section>

<h1>Contact</h1>

<section>
    <ul class="bullet-list">
        <li> <a target="_blank" rel="noopener" href="https://www.au.dk/en/ssh@cs.au.dk">University</a></li>
        <li> <a target="_blank" rel="noopener" href="https://orcid.org/0000-0002-8704-8503">ORCID</a></li>
        <li> <a target="_blank" rel="noopener" href="https://scholar.google.com/citations?user=dDGkq_YAAAAJ">Google Scholar</a></li>
        <li> <a target="_blank" rel="noopener" href="https://github.com/SebiH">GitHub</a></li>
        <li> <a target="_blank" rel="noopener" href="https://www.linkedin.com/in/sebastianhubenschmid">LinkedIn</a></li>
        <li> <a target="_blank" rel="noopener" href="https://instagram.com/s_hubenschmid/">Instagram</a></li>
        <li> <a target="_blank" rel="noopener" href="mailto:ssh@cs.au.dk">Email</a></li>
    </ul>
</section>
</Default>
