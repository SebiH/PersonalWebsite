---
import Head from '../components/Head.astro';
import Title from '../components/Title.astro';

interface Props {
  title: string;
  path?: string;
  jsonLd?: boolean;
}

const { title, path, jsonLd } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
    <Head title={title} path={path} jsonLd={jsonLd} />
    <body class="center">
        <header id="head">
            <div id="title">
                <Title />
            </div>
        </header>

        <main id="content">
            <slot />
        </main>
    </body>
</html>
