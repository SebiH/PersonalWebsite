---
import Icon from './Icon.astro';

interface Props {
  publication: { best_paper?: boolean | string; honorable_mention?: boolean | string };
  marker?: boolean;
  compact?: boolean;
}

const { publication, marker = false, compact = false } = Astro.props;
const bp = publication.best_paper;
const hm = publication.honorable_mention;

let kind = '';
let label = '';
if (bp) {
  kind = 'best';
  label = bp === true ? 'Best Paper Award' : bp;
} else if (hm) {
  kind = 'honorable';
  label = hm === true ? 'Honorable Mention' : hm;
}
const icon = kind === 'best' ? 'trophy' : 'award';
---
{kind !== '' && (
  marker ? (
    <span class={`award-marker award-${kind}`} aria-hidden="true" title={label}><Icon name={icon} width={16} height={16} /></span>
  ) : compact ? (
    <span class={`award award-${kind} compact`} title={label} role="img" aria-label={label}><Icon name={icon} width={16} height={16} /></span>
  ) : (
    <span class={`award award-${kind}`}><Icon name={icon} width={16} height={16} /><span class="award-label">{label}</span></span>
  )
)}
