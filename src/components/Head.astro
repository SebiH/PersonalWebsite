---
import '../styles/main.scss';

interface Props {
  title: string;
  path?: string;
  jsonLd?: boolean;
}

const { title, path = Astro.url.pathname, jsonLd = false } = Astro.props;
const description = 'Sebastian Hubenschmid, PostDoc at Aarhus University, Denmark';
const canonical = new URL(path, Astro.site).href;

const profile = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: 'https://sebi.sh/',
  mainEntity: {
    '@type': 'Person',
    name: 'Sebastian Hubenschmid',
    givenName: 'Sebastian',
    familyName: 'Hubenschmid',
    url: 'https://sebi.sh/',
    image: 'https://sebi.sh/og-image.jpg',
    jobTitle: 'Postdoctoral Research Fellow',
    affiliation: { '@type': 'CollegeOrUniversity', name: 'Aarhus University', url: 'https://www.au.dk/' },
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Konstanz', url: 'https://www.uni-konstanz.de/' },
    knowsAbout: ['Human-Computer Interaction', 'Mixed Reality', 'Visual Analytics', 'Hybrid User Interfaces', 'Immersive Analytics', 'Ambient Analytics', 'Augmented Reality', 'Virtual Reality', 'Computer Science'],
    sameAs: [
      'https://scholar.google.com/citations?user=dDGkq_YAAAAJ',
      'https://orcid.org/0000-0002-8704-8503',
      'https://github.com/SebiH',
      'https://www.au.dk/en/ssh@cs.au.dk',
      'https://www.linkedin.com/in/sebastianhubenschmid',
    ],
  },
};
---
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{title}</title>
    <meta name="keywords" content="Sebastian Hubenschmid, Aarhus University, Human-Computer Interaction, Mixed Reality, Computer Science">
    <meta name="description" content={description}>

    <link rel="canonical" href={canonical}>
    <link rel="shortcut icon" type="image/png" href="/favicon.png">
    <link rel="apple-touch-icon" type="image/png" href="/favicon.png">

    <meta property="og:title" content="Sebastian Hubenschmid" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://sebi.sh/" />
    <meta name="twitter:card" content="summary" />
    <meta property="og:image" content="https://sebi.sh/og-image.jpg" />
    <meta property="og:image:width" content="500" />
    <meta property="og:image:height" content="500" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content="Portrait of Sebastian Hubenschmid" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(profile)} is:inline />}
</head>
